# Example environment variables for deployment — DO NOT COMMIT real secrets
# Copy to `.env` on the server and set real secret values there.

# Database
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# Django security / reverse-proxy
DEBUG=false
SECRET_KEY=change-me
ALLOWED_HOSTS=na-mahlzeit.de,www.na-mahlzeit.de,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://localhost,https://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost,http://localhost:5173,https://localhost,https://localhost:5173
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

# Registry (used by CI to push/pull images)
REGISTRY=ghcr.io/your-org

# Deployment
DEPLOY_PATH=/path/to/deploy

# IMAGE_TAG will be set by CI on tag-triggered deploys
IMAGE_TAG=latest
