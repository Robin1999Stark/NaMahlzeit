# Example environment variables for deployment — DO NOT COMMIT real secrets
# Copy to `.env` on the server and set real secret values there.

# Database
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# Registry (used by CI to push/pull images)
REGISTRY=ghcr.io/your-org

# Deployment
DEPLOY_PATH=/path/to/deploy

# IMAGE_TAG will be set by CI on tag-triggered deploys
IMAGE_TAG=latest
